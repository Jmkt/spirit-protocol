#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { Command } = require('commander');
const yaml = require('js-yaml');

const SPIRITS_DIR = path.join(__dirname, '..', 'spirits');

function loadSpirit(name) {
  const filePath = path.join(SPIRITS_DIR, `${name}.spirit.md`);
  if (!fs.existsSync(filePath)) {
    console.error(`Error: spirit "${name}" not found at ${filePath}`);
    process.exit(1);
  }
  return fs.readFileSync(filePath, 'utf8');
}

function listSpirits() {
  if (!fs.existsSync(SPIRITS_DIR)) {
    console.error(`Error: spirits directory not found at ${SPIRITS_DIR}`);
    process.exit(1);
  }

  const files = fs.readdirSync(SPIRITS_DIR)
    .filter(f => f.endsWith('.spirit.md'))
    .sort();

  for (const file of files) {
    const content = fs.readFileSync(path.join(SPIRITS_DIR, file), 'utf8');
    const nameMatch = content.match(/^name:\s*(.+)$/m);
    const tagMatch = content.match(/^tag:\s*(.+)$/m);
    const name = nameMatch ? nameMatch[1].trim() : file.replace('.spirit.md', '');
    const tag = tagMatch ? tagMatch[1].trim() : '-';
    console.log(`${name.padEnd(20)} [${tag}]`);
  }
}

function invokeSpirit(name) {
  const content = loadSpirit(name);
  console.log(content);
}

function appendLog(name, message) {
  const content = loadSpirit(name);
  const today = new Date().toISOString().split('T')[0];

  const logMatch = content.match(/^## LOG\s*$/m);
  if (!logMatch) {
    console.error('Error: spirit has no ## LOG section');
    process.exit(1);
  }

  const logIndex = logMatch.index + logMatch[0].length;
  const before = content.slice(0, logIndex);
  const after = content.slice(logIndex);

  const entry = `\n- ${today}: ${message}`;
  const updated = before + entry + after;

  const filePath = path.join(SPIRITS_DIR, `${name}.spirit.md`);
  fs.writeFileSync(filePath, updated, 'utf8');
  console.log(`Appended to ${name}.spirit.md LOG`);
}

function appendGap(name, message) {
  const content = loadSpirit(name);
  const today = new Date().toISOString().split('T')[0];

  const gapMatch = content.match(/^## §6 · GAPS_LOG\s*$/m);
  if (!gapMatch) {
    console.error('Error: spirit has no ## §6 · GAPS_LOG section');
    process.exit(1);
  }

  const gapIndex = gapMatch.index + gapMatch[0].length;
  const before = content.slice(0, gapIndex);
  const after = content.slice(gapIndex);

  const entry = `\n- [${today}] ${message}`;
  const updated = before + entry + after;

  const filePath = path.join(SPIRITS_DIR, `${name}.spirit.md`);
  fs.writeFileSync(filePath, updated, 'utf8');
  console.log(`Appended to ${name}.spirit.md §6 GAPS_LOG`);
}

const program = new Command();

program
  .name('spirit')
  .description('CLI for Spirit.MD portable AI personas')
  .version('0.1.0');

program
  .command('list')
  .description('List all available spirits')
  .action(() => {
    listSpirits();
  });

program
  .command('invoke <name>')
  .description('Print a spirit for copy-paste into an LLM')
  .action((name) => {
    invokeSpirit(name);
  });

program
  .command('log <name> <message>')
  .description('Append a session note to a spirit LOG')
  .action((name, message) => {
    appendLog(name, message);
  });

program
  .command('gaps <name> <message>')
  .description('Append a knowledge gap to a spirit §6 GAPS_LOG')
  .action((name, message) => {
    appendGap(name, message);
  });

program
  .command('validate [path]')
  .description('Validate a .spirit.md file or directory')
  .action((filePath) => {
    const target = filePath || SPIRITS_DIR;
    const { execSync } = require('child_process');
    try {
      const output = execSync(`node ${path.join(__dirname, '..', 'src', 'validate.js')} ${target}`, {
        encoding: 'utf8',
        stdio: 'pipe'
      });
      console.log(output);
    } catch (err) {
      console.error(err.stdout || err.message);
      process.exit(1);
    }
  });

program.parse(process.argv);
